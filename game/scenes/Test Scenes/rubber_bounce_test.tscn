[sub_resource type="GDScript" id="GDScript_thslv"]
script/source = "extends TileMap


# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.

func _input(event):
	if event is InputEventMouseButton:
		var mouse_click = event as InputEventMouseButton
		if mouse_click.button_index == MOUSE_BUTTON_LEFT:
			var tile_pos = local_to_map(to_local(get_global_mouse_position()))
			var tile_data = get_cell_tile_data(0, tile_pos)
			if tile_data:
				var bounce = tile_data.get_custom_data_by_layer_id(0)
				print(\"Mouse Bounce value: \", bounce)
"

